app.app: zed
-

tag(): user.tabs

show git:
    key(ctrl-shift-g)

show files:
    key(cmd-shift-e)

(toggle|show|hide) threads:
    key(cmd-alt-j)

please:
    key(cmd-p)

(toggle|show|hide) agent:
    key(cmd-r)

symbols:
    key(cmd-shift-o)

bookmark:
    key(cmd-ctrl-shift-alt-g)

show bookmarks:
    key(cmd-ctrl-shift-alt-f)
